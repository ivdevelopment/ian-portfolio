# Copy to .env.local and fill in. Never commit real values.
# `npx supabase start` prints the local URL and keys; for a hosted project use
# Project Settings -> API in the Supabase dashboard.

# --- Required in production (Vercel -> Project -> Settings -> Environment Variables) ---

# Public (sent to the browser). The anon / publishable key is safe to expose: RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The real public origin, no trailing slash, e.g. https://www.example.com
# Used for canonical URLs, Open Graph, sitemap, robots, review invitation and password recovery links.
# On Vercel a missing value falls back to the project's production domain; a production build with neither fails.
NEXT_PUBLIC_SITE_URL=

# Secret salt for hashing visitor IPs used by contact-form rate limiting. Generate a long random string.
INQUIRY_HASH_SALT=

# --- Optional: Cloudflare Turnstile (contact form anti-spam) ---
# Unset = not enforced (local development). For local testing use Cloudflare's published always-pass test keys:
#   site key  1x00000000000000000000AA   secret  1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Your machine ONLY. NEVER set in hosting. ---
# Used solely by scripts/create-admin.mjs and scripts/reset-admin-password.mjs. The running app never uses it.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
