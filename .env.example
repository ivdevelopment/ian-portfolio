# Copy to .env.local and fill in. Never commit real values.
# `npx supabase start` prints the local URL and keys; for a hosted project use
# Project Settings -> API in the Supabase dashboard.

# Public (sent to the browser). The anon / publishable key is safe to expose: RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret. NOT used by the running app. Only `scripts/create-admin.mjs` reads it, from your own machine.
# Never prefix with NEXT_PUBLIC_ and never set it in the hosting environment.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (canonical links, sitemap).
NEXT_PUBLIC_SITE_URL=

# Optional: secret salt for hashing visitor IPs used for contact-form rate limiting.
INQUIRY_HASH_SALT=
