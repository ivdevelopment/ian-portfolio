# Copy to .env.local and fill in. Never commit real values.
# `npx supabase start` prints the local URL and keys; for a hosted project use
# Project Settings -> API in the Supabase dashboard.

# --- Required in production (Vercel -> Project -> Settings -> Environment Variables) ---

# Public (sent to the browser). The anon / publishable key is safe to expose: RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The real public origin, no trailing slash, e.g. https://www.example.com
# Used for canonical URLs, Open Graph, sitemap, robots, review invitation and password recovery links.
# On Vercel a missing value falls back to the project's production domain; a production build with neither fails.
NEXT_PUBLIC_SITE_URL=

# Secret salt for hashing visitor IPs used by contact-form rate limiting. Generate a long random string.
INQUIRY_HASH_SALT=

# --- Optional: Cloudflare Turnstile (contact form anti-spam) ---
# Unset = not enforced (local development). For local testing use Cloudflare's published always-pass test keys:
#   site key  1x00000000000000000000AA   secret  1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional: new-inquiry email notification (Zoho SMTP, server-only) ---
# Unset = notifications disabled (inquiries are still saved). Use an application-specific password if Zoho 2FA is on.
# Never prefix any of these with NEXT_PUBLIC_.
ZOHO_SMTP_HOST=smtppro.zoho.eu
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=hello@ianverlinden.com
ZOHO_SMTP_PASSWORD=
CONTACT_NOTIFICATION_EMAIL=hello@ianverlinden.com

# --- Client previews (access-code protected subdomains; see docs/client-previews.md) ---
# Server-only. The gateway deployment needs ALL of these; the admin only needs PREVIEW_BASE_DOMAIN (optional, defaults below).
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Signs preview session cookies (>= 32 characters). Rotating it signs every preview visitor out.
PREVIEW_SESSION_SECRET=
# Salt for hashing visitor IPs used by access-code rate limiting (>= 16 characters).
PREVIEW_IP_HASH_SALT=
# The domain previews live under: <name>.<this domain>.
PREVIEW_BASE_DOMAIN=ianverlinden.com
# Set to 1 ONLY on a dedicated gateway deployment: it then answers preview hostnames and nothing else.
PREVIEW_GATEWAY_ONLY=
# Secret a client's origin requires (>= 24 characters), one per client_previews.upstream_secret_ref.
# The variable name is PREVIEW_UPSTREAM_SECRET_<REF in upper case>, e.g. ref "geertkips":
# PREVIEW_UPSTREAM_SECRET_GEERTKIPS=

# --- Your machine ONLY. NEVER set in hosting. ---
# Used solely by scripts/create-admin.mjs and scripts/reset-admin-password.mjs. The running app never uses it.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
