{
  "name": "ian-verlinden",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rls": "node --env-file=.env.supabase-local node_modules/vitest/vitest.mjs run tests/rls.integration.test.ts tests/rls-p2.integration.test.ts tests/rls-p5.integration.test.ts",
    "db:start": "supabase start -x imgproxy,postgres-meta,vector,studio,mailpit,realtime,logflare,edge-runtime",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "admin:create": "node --env-file=.env.supabase-local scripts/create-admin.mjs",
    "dev:local": "node scripts/run-local.mjs next dev",
    "build:local": "node scripts/run-local.mjs next build",
    "start:local": "node scripts/run-local.mjs next start",
    "admin:reset-password": "node --env-file=.env.local scripts/reset-admin-password.mjs",
    "admin:diagnose": "node --env-file=.env.local scripts/diagnose-auth.mjs",
    "portfolio:import": "node --env-file=.env.local scripts/portfolio-import/import.mjs",
    "portfolio:import:local": "node --env-file=.env.supabase-local scripts/portfolio-import/import.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "geist": "^1.8.2",
    "lucide-react": "^1.63.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
