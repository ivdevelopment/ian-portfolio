{
  "name": "ian-prospect-agent-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Ian Prospect Agent: Windows tray application for the local prospect worker",
  "author": "Ian Verlinden",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "node build.mjs && electron-builder --win nsis --x64 --publish never",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.ianverlinden.prospect-agent",
    "productName": "Ian Prospect Agent",
    "executableName": "Ian Prospect Agent",
    "copyright": "Private internal tool",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ian Prospect Agent",
      "artifactName": "Ian Prospect Agent Setup.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
